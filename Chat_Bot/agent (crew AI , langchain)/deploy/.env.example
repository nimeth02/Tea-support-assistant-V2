# Settings for `docker compose up`. Copy to deploy/.env and fill in. Never commit the real file.

# ---- Required ----------------------------------------------------------------------------
GEMINI_API_KEY=
# Shared secret between the orchestrator and the experts. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The experts refuse to start in production without it.
A2A_AUTH_TOKEN=

# ---- Usually left as is ------------------------------------------------------------------
ENVIRONMENT=production
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_RPM=5
GROQ_API_KEY=
VECTOR_DB_PROVIDER=chroma
WHETHER_API=

# Resilience (see ops/resilience.py)
A2A_TIMEOUT_SECONDS=120
A2A_CONNECT_RETRIES=2
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_SECONDS=30
EXPERT_TIMEOUT_SECONDS=90

# Guardrails (see ops/guardrails.py)
MAX_INPUT_CHARS=2000
MAX_OUTPUT_CHARS=4000

# Logs: json for log tools (Loki, ELK, CloudWatch), text for reading by eye
LOG_FORMAT=json
LOG_LEVEL=INFO

# Optional LangSmith tracing (one trace across all three frameworks)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT_HYBRID=tea-support-agent-hybrid

GRAFANA_ADMIN_PASSWORD=admin
