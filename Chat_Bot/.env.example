LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash

# Optional - only if LLM_PROVIDER=groq
GROQ_API_KEY=

# Vector DB for disease/company-help RAG: chroma (local, default) or pinecone (cloud)
VECTOR_DB_PROVIDER=chroma

# Optional - only if VECTOR_DB_PROVIDER=pinecone (needs the original author's Pinecone indexes)
PINECONE_API_KEY=
PINECONE_DISEASE_INDEX_NAME=tea-disease
PINECONE_HELP_INDEX_NAME=company-help
COHERE_API_KEY=

# Optional - weatherapi.com key for rain forecast
WHETHER_API=

# Optional - LangSmith tracing (https://smith.langchain.com). Off by default; when on, every
# LLM/tool/graph-node call is traced there automatically, alongside the existing Prometheus/SQLite
# observability (this doesn't replace it).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tea-support-assistant
# Each agent variant traces to its own project (see variants.py). Optional per-variant overrides:
# LANGSMITH_PROJECT_AGENT=tea-support-agent-langgraph
# LANGSMITH_PROJECT_LANGCHAIN=tea-support-agent-langchain
# LANGSMITH_PROJECT_A2A=tea-support-agent-a2a
# LANGSMITH_PROJECT_CREWAI=tea-support-agent-crewai
# LANGSMITH_PROJECT_HYBRID=tea-support-agent-hybrid
# LANGSMITH_PROJECT_VOICE=tea-support-agent-voice

# Multilingual + voice variant only (python launch.py up voice)
# Speech-to-text: gemini (default, uses GEMINI_API_KEY) or groq (Whisper, uses GROQ_API_KEY)
STT_PROVIDER=gemini
GROQ_WHISPER_MODEL=whisper-large-v3
# Text-to-speech: gtts (default, Google Translate voices) or edge (Microsoft neural voices). No keys.
TTS_PROVIDER=gtts

# Optional - only needed for the throwaway pandasai experiment in test.py
PANDASAI_API_KEY=
