{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-env-commit.sh",
            "if": "Bash(git *)",
            "statusMessage": "Checking for .env in git command..."
          }
        ]
      }
    ]
  }
}
